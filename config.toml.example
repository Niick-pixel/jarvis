# Copy to config.toml. Every value here is also settable as JARVIS_<KEY> in the environment.

[server]
host = "127.0.0.1"          # A non-loopback bind requires auth_token, or the app refuses to start.
port = 8080
auth_token = ""             # Only needed if you change host away from loopback.

[paths]
data_dir = "./data"         # jarvis.db lives here
models_dir = "./models"     # downloaded GGUF files
memory_dir = "./memory"     # your memory, as Markdown in a git repo you can read and edit

[providers.llamacpp]
enabled = true
base_url = "http://127.0.0.1:8081"
# Started for you by `make dev` when autostart = true and model_path is set.
autostart = false
model_path = ""
ctx_len = 0                 # 0 = pick the largest context your VRAM budget allows

[providers.ollama]
enabled = true
base_url = "http://127.0.0.1:11434"

[providers.lmstudio]
enabled = true
base_url = "http://127.0.0.1:1234"

[providers.openai]
enabled = false
base_url = "https://api.openai.com/v1"
# Read from the JARVIS_OPENAI_API_KEY environment variable, never stored in this file.

[visual]
preset = "aurora"           # aurora | solar | deep
performance_mode = "auto"   # auto | on | off - "auto" drops the shader when VRAM is tight

[hardware]
browser_vram_reserve_mb = 700   # Chromium GPU process + compositor share your card (see PLAN.md 1.1)
kv_cache_dtype = "q8_0"         # q8_0 halves KV cost vs f16 at negligible quality cost

[memory]
auto_extract = true         # capture durable facts after a turn; always shown, always undoable
min_answer_chars = 200      # skip short exchanges - a second generation is not free on a small card
max_facts_per_turn = 3

[knowledge]
# A loopback endpoint serving an embedding model, e.g. a second llama-server on 8082 with
# nomic-embed-text. Leave empty for keyword-only retrieval - the app says which it is using.
embeddings_base_url = ""
embeddings_model_id = "nomic-embed-text"
rag_results = 4

[search]
# A SearXNG instance you run yourself, on loopback. `make searxng` installs one natively.
# Queries never leave this machine except through SearXNG's own fan-out to upstream engines.
base_url = ""
max_results = 5
research_rounds = 2         # round one searches the question; later rounds chase what is missing
fetch_pages = false         # fetching a result contacts that site directly - off by default
