# Copy to config.toml. Every value here is also settable as JARVIS_<KEY> in the environment.

[server]
host = "127.0.0.1"          # A non-loopback bind requires auth_token, or the app refuses to start.
port = 8080
auth_token = ""             # Only needed if you change host away from loopback.

[paths]
data_dir = "./data"         # jarvis.db lives here
models_dir = "./models"     # downloaded GGUF files
memory_dir = "./memory"     # your memory, as Markdown in a git repo you can read and edit
vault_dir = "./vault"       # exported conversations land here; point it at an Obsidian vault

[providers.llamacpp]
enabled = true
base_url = "http://127.0.0.1:8081"
# With autostart, `make dev` starts llama-server and stops it again when you stop the app. It waits
# for the model to finish loading before calling it started, reports llama-server's own words when
# it does not, and never touches a server that is already listening on base_url.
autostart = false
binary = "llama-server"     # resolved on PATH unless this is an absolute path
model_path = ""             # empty = the largest registered model this card can actually hold
ctx_len = 0                 # 0 = the largest context that fits, by the same arithmetic the picker uses
extra_args = []             # appended verbatim, so any flag this project does not know is reachable
startup_timeout_s = 180.0   # past this it is killed and the tail of its own log is what you see

[providers.ollama]
enabled = true
base_url = "http://127.0.0.1:11434"

[providers.lmstudio]
enabled = true
base_url = "http://127.0.0.1:1234"

[providers.openai]
enabled = false
base_url = "https://api.openai.com/v1"
# Read from the JARVIS_OPENAI_API_KEY environment variable, never stored in this file.

[visual]
preset = "aurora"           # aurora | solar | deep
performance_mode = "auto"   # auto | on | off - "auto" drops the shader when VRAM is tight

[hardware]
browser_vram_reserve_mb = 700   # Chromium GPU process + compositor share your card (see PLAN.md 1.1)
kv_cache_dtype = "q8_0"         # q8_0 halves KV cost vs f16 at negligible quality cost

[memory]
auto_extract = true         # capture durable facts after a turn; always shown, always undoable
min_answer_chars = 200      # skip short exchanges - a second generation is not free on a small card
max_facts_per_turn = 3

[knowledge]
# A loopback endpoint serving an embedding model, e.g. a second llama-server on 8082 with
# nomic-embed-text. Leave empty for keyword-only retrieval - the app says which it is using.
embeddings_base_url = ""
embeddings_model_id = "nomic-embed-text"
rag_results = 4             # how many chunks reach the context window

# A third llama-server, started with --reranking and a cross-encoder GGUF. A cross-encoder reads
# your question and each candidate together, which is what fixes "right file, wrong paragraph".
# It is another model resident on the same card: bge-reranker-v2-m3 at Q8 is about 600MB.
# Empty means the fused order is final, and the Knowledge panel says which you are getting.
rerank_base_url = ""
rerank_model_id = "bge-reranker-v2-m3"
rerank_candidates = 20      # fused hits the reranker reads before the top rag_results are kept
rerank_timeout_s = 20.0     # past this, fused order stands rather than the answer waiting

[search]
# A SearXNG instance you run yourself, on loopback. `make searxng` installs one natively.
# Queries never leave this machine except through SearXNG's own fan-out to upstream engines.
base_url = ""
max_results = 5
research_rounds = 2         # round one searches the question; later rounds chase what is missing
fetch_pages = false         # fetching a result contacts that site directly - off by default

[voice]
# Optional extra: `make voice-install` installs the engines, `make voice` downloads the weights.
# Nothing else ever fetches them, and the app says which half is missing and why.
stt_model = "small"             # tiny | base | small | medium | large-v3; small ~440MB on CUDA
stt_compute_type = "int8_float16"
stt_language = ""               # empty detects; pinning it is faster and steadier on short clips
tts_voice = "en_US-lessac-medium"
tts_length_scale = 1.0          # above 1.0 speaks slower
max_audio_mb = 25

[agents]
# Scheduled jobs. Every side effect stops at an approval gate until you allow it, per directory.
workspace = "./workspace"       # default writable root for a job that does not name its own
max_steps = 6                   # generate-then-call rounds before a run has to conclude
max_output_chars = 4000         # a tool result larger than this is truncated, visibly
shell_timeout_s = 20
approval_timeout_minutes = 30   # how long a parked run waits before giving up. It never runs it.
